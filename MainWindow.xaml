<Window
    x:Class="XAML解析.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:XAML解析"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <TextBox
            x:Name="源字符串控件"
            Grid.Column="0"
            AcceptsReturn="True"
            Background="Black"
            Foreground="#FF0079FF"
            TextWrapping="Wrap" />
        <TextBox
            x:Name="解析字符串控件"
            Grid.Column="1"
            AcceptsReturn="True"
            Background="Black"
            Foreground="#FF06CC00"
            TextWrapping="Wrap" />
        <StackPanel
            Grid.Column="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Top">
            <Button
                Grid.Column="1"
                Margin="10"
                Padding="4"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Click="Button_Click"
                Content="解析" />
            <Button
                Grid.Column="1"
                Margin="10"
                Padding="4"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Click="Button_Click_1"
                Content="XAML序列化" />
        </StackPanel>

    </Grid>
</Window>
