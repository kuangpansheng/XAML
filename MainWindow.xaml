<Window x:Class="XAML解析.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:XAML解析"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid    >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.2*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="源字符串控件" Grid.Column="0" TextWrapping="Wrap" AcceptsReturn="True" Background="Black" Foreground="#FF0079FF"/>
        <TextBox x:Name="解析字符串控件" Grid.Column="1" TextWrapping="Wrap" AcceptsReturn="True" Background="Black" Foreground="#FF06CC00"/>
        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button Content="解析" Padding="4" Click="Button_Click" Margin="10" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top"/>
            <Button Content="XAML序列化" Padding="4" Click="Button_Click_1" Margin="10" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        </StackPanel>
      
    </Grid>
</Window>
